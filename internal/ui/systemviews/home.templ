package systemviews

import (
	"bnema.dev/dumber/internal/application/dto"
	"bnema.dev/dumber/internal/domain/entity"
)

// HomePage renders the dumb://home view from its pre-rendered regions; the
// home-groups entry is a placeholder for the service groups.
templ HomePage(regions []DOMRegion, load dto.HomeLoadResponse, shape homeShape, leaves map[string]string) {
	<div class="sv-home" data-sv-region="home">
		for _, region := range regions {
			if isHomeWidgetRegion(region.Name) {
				// Rendered in the widgets container below the header.
			} else if region.Name == homeRegionHeader {
				<div class="sv-home-region" data-sv-region={ region.Name }>
					@templ.Raw(region.HTML)
				</div>
				<div class="sv-home-widgets" data-sv-region={ homeRegionWidgets }>
					@HomeWidgetRegions(regions)
				</div>
			} else if region.Name == homeRegionGroups {
				<div class="sv-home-region sv-home-region-groups">
					@HomeGroups(load, shape, leaves)
				</div>
			} else {
				<div class="sv-home-region" data-sv-region={ region.Name }>
					@templ.Raw(region.HTML)
				</div>
			}
		}
	</div>
}

// HomeWidgetRegions renders the built-in widget regions of regions. A change
// of the widget list swaps this whole list, and nothing else.
templ HomeWidgetRegions(regions []DOMRegion) {
	for _, region := range regions {
		if isHomeWidgetRegion(region.Name) {
			<div class="sv-home-region" data-sv-region={ region.Name }>
				@templ.Raw(region.HTML)
			</div>
		}
	}
}

templ HomeErrors(load dto.HomeLoadResponse) {
	if homeHasErrors(load) {
		<div class="sv-home-errors" role="alert">
			<p class="sv-home-errors-title">home.toml has errors; showing the last valid layout.</p>
			if load.ParseError != nil {
				<p class="sv-home-error"><code class="sv-home-error-path">{ homeParseErrorLocation(load.ParseError) }</code> { load.ParseError.Message }</p>
			}
			if len(load.ValidationErrors) > 0 {
				<ul class="sv-home-error-list">
					for _, verr := range load.ValidationErrors {
						<li class="sv-home-error"><code class="sv-home-error-path">{ verr.Path }</code>: { verr.Message }</li>
					}
				</ul>
			}
		</div>
	}
}

// HomeHeader is the title with ghost controls. The clock and status summary
// regions are its siblings; CSS puts them on the same line.
templ HomeHeader(load dto.HomeLoadResponse) {
	<header class="sv-home-header">
		<h2 class="sv-home-title">{ homeTitle(load) }</h2>
		<button type="button" class="sv-home-ghost sv-home-open-config" data-sv-action="home.openConfig" title={ load.ConfigPath }>Open home.toml</button>
		<button type="button" class="sv-palette-trigger sv-home-ghost" data-sv-action="palette.open" aria-keyshortcuts="Control+K">
			<span>Actions</span>
			<kbd>Ctrl</kbd><kbd>K</kbd>
		</button>
	</header>
}

// HomeStatusSummary is the service count of the header line, empty when
// there are no services.
templ HomeStatusSummary(count int) {
	if count > 0 {
		<span class="sv-home-status-summary">{ homeServiceCountText(count) }</span>
	}
}

templ HomeWidget(widget homeWidgetData) {
	<div class={ "sv-home-widget", "sv-home-widget-" + string(widget.Widget.Type) }>
		switch widget.Widget.Type {
			case entity.HomeWidgetSearch:
				@homeSearchWidget()
			case entity.HomeWidgetClock:
				<div class="sv-home-clock">
					<span class="sv-home-clock-date">{ widget.Date }</span>
					<span class="sv-home-clock-sep" aria-hidden="true">·</span>
					<time class="sv-home-clock-time">{ widget.Time }</time>
				</div>
			default:
				<h3 class="sv-home-section-title">{ homeWidgetTitle(widget.Widget) }</h3>
				if widget.Loading {
					<ul class="sv-home-rows sv-home-loading" aria-busy="true">
						for range 3 {
							<li class="sv-home-skeleton"></li>
						}
					</ul>
				} else if widget.Error != "" {
					<p class="sv-home-muted">{ widget.Error }</p>
				} else if len(widget.Rows) == 0 {
					<p class="sv-home-muted">Nothing here yet.</p>
				} else {
					<ul class="sv-home-rows">
						for _, row := range widget.Rows {
							<li>@homeRowLink(row, false)</li>
						}
					</ul>
				}
		}
	</div>
}

templ homeSearchWidget() {
	<form class="sv-home-search" data-sv-action="home.search" role="search" autocomplete="off">
		<input class="sv-input sv-home-search-input" type="search" name="query" placeholder="Search or enter address" aria-label="Search or enter address" data-sv-home-search data-sv-autofocus/>
		<div class="sv-home-suggestions" role="listbox" data-sv-region={ homeRegionSuggestions }></div>
	</form>
}

templ HomeSuggestions(rows []homeRow) {
	for _, row := range rows {
		@homeRowLink(row, true)
	}
}

templ homeRowLink(row homeRow, suggestion bool) {
	{{ favicon := homeFaviconURL(row.URL) }}
	<a
		class={ "sv-home-row", templ.KV("sv-home-suggestion", suggestion) }
		href={ templ.SafeURL(sanitizeHref(row.URL)) }
		title={ row.URL }
		data-sv-home-nav
		if suggestion {
			data-sv-home-suggestion
			role="option"
		}
	>
		<span class={ historyFaviconClass(favicon) } aria-hidden="true">
			<span class="sv-history-favicon-fallback">{ homeInitial(homeRowLabel(row)) }</span>
			if favicon != "" {
				<img src={ templ.SafeURL(favicon) } alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="same-origin" data-sv-img-fallback={ "sv-history-favicon-has-image" }/>
			}
		</span>
		<span class="sv-home-row-title">{ homeRowLabel(row) }</span>
		<span class="sv-home-row-url">{ stripURLScheme(row.URL) }</span>
	</a>
}

templ HomeBookmarks(groups []entity.HomeBookmarkGroup) {
	if len(groups) > 0 {
		<div class="sv-home-bookmarks">
			for _, group := range groups {
				<section class="sv-home-bookmark-group">
					<h3 class="sv-home-section-title">{ group.Group }</h3>
					<ul class="sv-home-rows">
						for _, link := range group.Links {
							<li>@homeRowLink(homeRow{URL: link.URL, Title: link.Name}, false)</li>
						}
					</ul>
				</section>
			}
		</div>
	}
}

// HomeGroups is the service skeleton: group blocks with a title region and
// one shell per service. Containers are anchors, never regions, so a swap can
// not re-create the iframes below them.
templ HomeGroups(load dto.HomeLoadResponse, shape homeShape, leaves map[string]string) {
	<div class="sv-home-groups" style={ homeGridStyle(load) } data-sv-anchor={ homeAnchorGroups }>
		for gi := range load.Layout.Groups {
			@HomeGroupBlock(load.Layout.Groups[gi], shape.Groups[gi].Key, leaves)
		}
	</div>
}

// HomeGroupBlock is one group; it is also the markup inserted for a new
// group.
templ HomeGroupBlock(group entity.HomeGroup, key string, leaves map[string]string) {
	<section class="sv-home-group" data-sv-anchor={ homeGroupAnchor(key) }>
		<div class="sv-home-group-head">
			<h3 class="sv-home-section-title" data-sv-region={ homeGroupTitleRegion(key) }>
				@templ.Raw(leaves[homeGroupTitleRegion(key)])
			</h3>
			<span class="sv-home-group-count" data-sv-region={ homeGroupCountRegion(key) }></span>
		</div>
		<div class="sv-home-grid" data-sv-anchor={ homeGridAnchor(key) }>
			for _, service := range group.Services {
				@HomeServiceShell(service, leaves)
			}
		</div>
	</section>
}

templ HomeGroupTitle(name string) {
	{ name }
}

// HomeServiceShell is a service row. It holds the independent regions of a
// service as siblings: the tile, the api widget and actions slots, the
// status slot and the embed. It is also the markup inserted for a new
// service.
templ HomeServiceShell(service entity.HomeService, leaves map[string]string) {
	<div class="sv-home-service" data-sv-home-service={ service.ID } data-sv-anchor={ homeShellAnchor(service.ID) }>
		<div class="sv-home-service-tile" data-sv-region={ homeServiceTileRegion(service.ID) }>
			@templ.Raw(leaves[homeServiceTileRegion(service.ID)])
		</div>
		@homeServiceWidgetSlot(service)
		<div class="sv-home-service-status" data-sv-region={ homeServiceStatusRegion(service.ID) }></div>
		<div class="sv-home-service-embed" data-sv-region={ homeServiceEmbedRegion(service.ID) }></div>
	</div>
}

// HomeServiceTile is the content of a tile region: link, icon, name and
// description.
templ HomeServiceTile(service entity.HomeService) {
	if service.URL != "" {
		<a class="sv-home-service-link" href={ templ.SafeURL(sanitizeHref(service.URL)) } title={ service.URL } data-sv-home-nav>
			@homeServiceHead(service)
		</a>
	} else {
		<div class="sv-home-service-link" tabindex="0" data-sv-home-nav>
			@homeServiceHead(service)
		</div>
	}
}

templ homeServiceHead(service entity.HomeService) {
	{{ icon := homeServiceIconURL(service) }}
	<span class={ "sv-home-service-icon", templ.KV("sv-home-service-icon-has-image", icon != "") } aria-hidden="true">
		<span class="sv-home-service-glyph">{ homeInitial(service.Name) }</span>
		if icon != "" {
			<img src={ templ.SafeURL(icon) } alt="" width="20" height="20" loading="lazy" decoding="async" referrerpolicy="same-origin" data-sv-img-fallback={ "sv-home-service-icon-has-image" }/>
		}
	</span>
	<span class="sv-home-service-text">
		<span class="sv-home-service-name">{ service.Name }</span>
		if service.Description != "" {
			<span class="sv-home-service-description">{ service.Description }</span>
		}
	</span>
}

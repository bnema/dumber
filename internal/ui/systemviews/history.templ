package systemviews

import (
	"fmt"
	"strings"
	"time"
	"bnema.dev/dumber/internal/domain/entity"
)

// History regions are replaced in place by live updates (data-sv-region);
// the search form sits outside them so typing never loses focus or caret.
templ HistoryView(data historyRenderData) {
	<div class="sv-region" data-sv-region={ historyRegionAlerts }>
		@HistoryAlerts(data)
	</div>
	<section class="sv-panel sv-history-panel" aria-label="History">
		@HistoryControls(data)
		<div class="sv-region" data-sv-region={ historyRegionFilters } aria-live="polite">
			@HistoryFilters(data)
		</div>
		<div class="sv-region" data-sv-region={ historyRegionDomains }>
			@HistoryDomains(data)
		</div>
		<div class="sv-region" data-sv-region={ historyRegionTimeline }>
			@HistoryTimeline(data)
		</div>
		@HistoryFooter(data)
	</section>
}

templ HistoryAlerts(data historyRenderData) {
	@Alert("success", data.Notice)
	@Alert("error", data.Error)
}

templ HistoryControls(data historyRenderData) {
	<form class="sv-panel-search sv-history-search" data-sv-action="history.search" role="search" data-sv-focus-fallback>
		<label class="sv-search-field">
			@Icon(iconSearch)
			<span class="sv-sr-only">Search history</span>
			<input data-sv-history-search data-sv-autofocus name="query" type="search" value={ data.Query } placeholder="Search history" autocomplete="off" spellcheck="false" autofocus/>
		</label>
	</form>
}

templ HistoryFilters(data historyRenderData) {
	if showHistoryFilters(data) {
		<div class="sv-active-filters">
			<span class="sv-meta">{ historyShowingLabel(data) }</span>
			if data.DomainFilter != "" {
				<span class="sv-filter-chip">{ data.DomainFilter } <button type="button" data-sv-action="history.clearDomain" aria-label="Clear domain filter">@IconOnly(iconX, "Clear domain filter")</button></span>
			}
			<button class="sv-text-button" type="button" data-sv-action="history.clear">Clear filters</button>
		</div>
	}
}

templ HistoryDomains(data historyRenderData) {
	if !data.Loading && len(data.Domains) > 0 {
		<div class="sv-domain-list" role="group" aria-label="Top domains">
			for _, domain := range data.Domains {
				if domain != nil && domain.Domain != "" {
					{{ domainKey := historyDomainActionKey(domain) }}
					{{ displayDomain := historyDomainDisplayLabel(domain) }}
					<span class={ historyDomainChipClass(domainKey, data.DomainFilter) } title={ historyDomainTitle(domain) } data-sv-focus-key={ "domain-" + domainKey }>
						<button type="button" class="sv-domain-filter" data-sv-action="history.filterDomain" data-domain={ domainKey } aria-pressed={ historyDomainPressed(domainKey, data.DomainFilter) }>{ displayDomain }</button>
						<button type="button" class="sv-domain-delete" data-sv-action="history.deleteDomain" data-domain={ domainKey } data-sv-confirm={ "Delete all history for " + displayDomain + "?" } aria-label={ "Delete history for " + displayDomain }>@IconOnly(iconX, "Delete history for "+displayDomain)</button>
					</span>
				}
			}
		</div>
	}
}

templ HistoryFooter(data historyRenderData) {
	<footer class="sv-panel-footer">
		<p class="sv-key-hints">
			<span><kbd>j</kbd><kbd>k</kbd> move</span>
			<span><kbd>Enter</kbd> open</span>
			<span><kbd>d</kbd> delete</span>
			<span><kbd>/</kbd> search</span>
			<span><kbd>Esc</kbd> leave search</span>
			<span><kbd>Ctrl</kbd><kbd>K</kbd> actions</span>
		</p>
		<div class="sv-history-cleanup" role="group" aria-label="Delete history">
			<span class="sv-meta">Delete history:</span>
			for _, item := range historyCleanupItems() {
				<button type="button" class="sv-text-button sv-text-button-danger" data-sv-action="history.deleteRange" data-range={ item.RangeID } data-sv-confirm={ item.Confirm }>{ item.Label }</button>
			}
		</div>
	</footer>
}

templ HistoryTimeline(data historyRenderData) {
	if data.Loading {
		@LoadingPanel("Loading history…")
	} else {
		<div class="sv-history-timeline-list" data-sv-history-timeline>
			{{ groups := groupHistoryEntries(data.Entries) }}
			if len(groups) == 0 {
				@EmptyState(historyTimelineEmptyMessage(data))
			} else {
				@HistoryTimelineGroups(data.Entries, "")
			}
			@HistoryLoadMore(data)
		</div>
	}
}

templ HistoryTimelineAppend(data historyRenderData) {
	@HistoryTimelineAppendGroups(data.Entries, data.AppendSkipFirstDate)
	@HistoryLoadMore(data)
}

templ HistoryTimelineGroups(entries []*entity.HistoryEntry, skipFirstDate string) {
	{{ groups := groupHistoryEntries(entries) }}
	for _, group := range groups {
		@HistoryTimelineGroup(group, true)
	}
}

templ HistoryTimelineAppendGroups(entries []*entity.HistoryEntry, mergeFirstDate string) {
	{{ groups := groupHistoryEntries(entries) }}
	for index, group := range groups {
		if index == 0 && group.Date == mergeFirstDate {
			<div data-sv-history-merge-date={ group.Date }>
				for _, entry := range group.Entries {
					if entry != nil {
						@HistoryItem(entry)
					}
				}
			</div>
		} else {
			@HistoryTimelineGroup(group, true)
		}
	}
}

templ HistoryTimelineGroup(group historyTimelineGroup, showHeading bool) {
	<section class="sv-timeline-group" data-sv-history-date={ group.Date }>
		if showHeading {
			<h3 class="sv-divider">{ group.Label }</h3>
		}
		<ul class="sv-rows">
			for _, entry := range group.Entries {
				if entry != nil {
					@HistoryItem(entry)
				}
			}
		</ul>
	</section>
}

templ HistoryLoadMore(data historyRenderData) {
	<div class="sv-history-load-more" data-sv-history-load-more-container>
		if showHistoryLoadMore(data) {
			<button type="button" class="sv-button sv-button-neutral" data-sv-action="history.loadMore" data-before={ historyLoadMoreCursor(data) } data-sv-history-load-more>Load older visits</button>
		} else if strings.TrimSpace(data.Query) == "" && countHistoryEntries(data.Entries) > 0 {
			<p class="sv-meta">End of history</p>
		}
	</div>
}

templ HistoryItem(entry *entity.HistoryEntry) {
	<li>
		<article class="sv-row sv-history-item" data-sv-history-row data-history-id={ fmt.Sprintf("%d", entry.ID) } data-sv-focus-key={ fmt.Sprintf("history-%d", entry.ID) }>
			{{ faviconURL := historyItemFaviconURL(entry) }}
			<span class={ historyFaviconClass(faviconURL) } aria-hidden="true">
				<span class="sv-history-favicon-fallback">{ historyFaviconFallback(entry) }</span>
				if faviconURL != "" {
					<img src={ templ.SafeURL(faviconURL) } alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="same-origin" onerror="this.parentElement.classList.remove('sv-history-favicon-has-image'); this.remove()"/>
				}
			</span>
			<div class="sv-row-text">
				<a class="sv-row-title sv-history-open" href={ templ.SafeURL(sanitizeHref(entry.URL)) } title={ entry.URL }>{ historyItemLabel(entry) }</a>
				<p class="sv-row-subtitle">{ historyItemSubtitle(entry) }</p>
			</div>
			<div class="sv-row-meta">
				<time class="sv-history-time">{ historyItemTime(entry, time.Now().Local()) }</time>
				<button type="button" class="sv-icon-button sv-row-action" data-sv-action="history.deleteEntry" data-id={ fmt.Sprintf("%d", entry.ID) } data-sv-confirm="Delete this history entry?" data-sv-undoable aria-label="Delete this history entry" disabled?={ entry.ID <= 0 }>@IconOnly(iconTrash, "Delete this history entry")</button>
			</div>
		</article>
	</li>
}

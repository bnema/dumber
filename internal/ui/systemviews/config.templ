package systemviews

import (
	"strconv"

	"bnema.dev/dumber/internal/application/dto"
	"bnema.dev/dumber/internal/application/port"
)

// configFormID ties the save bar buttons, which live outside the form so
// they stay pinned while scrolling, to the settings form.
const configFormID = "sv-config-form"

templ ConfigView(data configRenderData) {
	<div class="sv-config" data-sv-config>
		<nav class="sv-config-nav" aria-label="Settings sections">
			for _, section := range configSections {
				<a class="sv-config-nav-link" href={ templ.SafeURL("#" + section.ID) } data-sv-config-nav={ section.ID }>
					<span>{ section.Label }</span>
					<span class="sv-config-nav-dot" aria-hidden="true"></span>
				</a>
			}
		</nav>
		<div class="sv-config-main">
			@Alert("success", data.Notice)
			@Alert("error", data.Error)
			<form id={ configFormID } class="sv-config-form" data-sv-action="config.saveBatch" data-sv-config-form data-sv-performance-form autocomplete="off">
				@ConfigAppearance(data.Config)
				@ConfigSearch(data.Config)
				@ConfigPerformance(data.Config)
				@ConfigKeybindings(data.Keybindings)
			</form>
			@ConfigAdvanced(data.Config)
			@ConfigSaveBar()
		</div>
	</div>
}

templ ConfigSection(id string, title string, description string) {
	<section id={ id } class="sv-config-section" aria-labelledby={ id + "-title" } data-sv-config-section>
		<div class="sv-config-section-header">
			<h2 id={ id + "-title" }>{ title }</h2>
			<p>{ description }</p>
		</div>
		{ children... }
	</section>
}

templ SettingsCard(title string) {
	<div class="sv-settings-card">
		if title != "" {
			<h3 class="sv-settings-card-title">{ title }</h3>
		}
		{ children... }
	</div>
}

// SettingRow lays out one setting: label and help on the left, control on
// the right. inputID labels the control.
templ SettingRow(inputID string, label string, help string) {
	<div class="sv-setting" data-sv-setting>
		<div class="sv-setting-text">
			<label class="sv-setting-label" for={ inputID }>{ label }</label>
			if help != "" {
				<p class="sv-setting-help">{ help }</p>
			}
		</div>
		<div class="sv-setting-control">
			{ children... }
		</div>
	</div>
}

// SettingGroupRow is a SettingRow for a group of controls (radios), labelled
// with aria-labelledby instead of <label for>.
templ SettingGroupRow(labelID string, label string, help string) {
	<div class="sv-setting" data-sv-setting>
		<div class="sv-setting-text">
			<span class="sv-setting-label" id={ labelID }>{ label }</span>
			if help != "" {
				<p class="sv-setting-help">{ help }</p>
			}
		</div>
		<div class="sv-setting-control">
			{ children... }
		</div>
	</div>
}

templ Segmented(name string, labelID string, options []segmentOption, current string, attrs templ.Attributes) {
	<div class="sv-segmented" role="radiogroup" aria-labelledby={ labelID }>
		for _, option := range options {
			<label class="sv-segment">
				<input type="radio" name={ name } value={ option.Value } checked?={ option.Value == current } { attrs... }/>
				<span>{ option.Label }</span>
			</label>
		}
	</div>
}

templ ConfigAppearance(config dto.SystemviewConfigPayload) {
	@ConfigSection("sv-config-appearance", "Appearance", "Theme, fonts and colors used by Dumber and its pages.") {
		@SettingsCard("") {
			@SettingGroupRow("sv-color-scheme-label", "Color scheme", "System follows your desktop's light or dark preference.") {
				@Segmented("color_scheme", "sv-color-scheme-label", colorSchemeOptions, normalizedOption(config.Appearance.ColorScheme, "default"), nil)
			}
			@SettingRow("sv-ui-scale", "Interface scale", "Zoom applied to every page, from 0.5 to 3.") {
				<div class="sv-input-affix">
					<input id="sv-ui-scale" class="sv-input sv-input-number" name="default_ui_scale" type="number" min="0.5" max="3" step="0.05" value={ formatConfigFloat(config.DefaultUIScale) } required/>
					<span aria-hidden="true">×</span>
				</div>
			}
			@SettingRow("sv-font-size", "Default font size", "Base text size for pages that do not set their own.") {
				<div class="sv-input-affix">
					<input id="sv-font-size" class="sv-input sv-input-number" name="default_font_size" type="number" min="1" max="72" value={ formatConfigInt(config.Appearance.DefaultFontSize) } required/>
					<span aria-hidden="true">px</span>
				</div>
			}
		}
		@SettingsCard("Fonts") {
			for _, font := range configFontFields(config.Appearance) {
				@SettingRow("sv-font-"+font.Name, font.Label, font.Help) {
					<input id={ "sv-font-" + font.Name } class="sv-input sv-input-font" name={ font.Name } type="text" value={ font.Value } placeholder="System default" spellcheck="false" data-sv-font-input/>
				}
			}
		}
		@PaletteCard("Light palette", "light", config.Appearance.LightPalette)
		@PaletteCard("Dark palette", "dark", config.Appearance.DarkPalette)
		@ExternalThemeCard(config.Appearance.ExternalTheme)
		<div class="sv-config-section-footer">
			<button class="sv-text-button sv-text-button-danger" type="button" data-sv-action="config.appearance.reset" data-sv-confirm="Reset appearance settings to defaults? Unsaved changes on this page are lost.">
				@ButtonIconLabel(iconRotateCCW, "Reset appearance to defaults")
			</button>
		</div>
	}
}

templ PaletteCard(title string, prefix string, palette dto.ColorPalette) {
	@SettingsCard(title) {
		<div class="sv-palette-editor">
			<div class="sv-color-grid">
				for _, field := range paletteFieldsOf(&palette) {
					@ColorField(prefix, field)
				}
			</div>
			<div class="sv-palette-preview" data-sv-palette-preview={ prefix } style={ palettePreviewVars(palette) } aria-hidden="true">
				<div class="sv-pp-window">
					<span class="sv-pp-title">Page title</span>
					<span class="sv-pp-muted">Secondary text</span>
					<div class="sv-pp-row">
						<span class="sv-pp-chip">Tag</span>
						<span class="sv-pp-button">Accent</span>
					</div>
				</div>
			</div>
		</div>
	}
}

templ ColorField(prefix string, field paletteField) {
	{{ name := prefix + "_" + field.Key }}
	<div class="sv-color-field" data-sv-color>
		<span class="sv-color-swatch" style={ swatchStyle(*field.Value) }>
			<input type="color" value={ colorPickerValue(*field.Value) } aria-label={ field.Label + " color picker" } data-sv-color-picker/>
		</span>
		<label class="sv-color-label" for={ "sv-" + name }>{ field.Label }</label>
		<input id={ "sv-" + name } class="sv-input sv-input-mono sv-color-input" name={ name } type="text" value={ *field.Value } spellcheck="false" required data-sv-color-input data-sv-palette={ prefix } data-sv-palette-key={ field.Key }/>
	</div>
}

templ ExternalThemeCard(theme dto.WebUIExternalThemeConfig) {
	@SettingsCard("External theme") {
		<div class="sv-external-theme">
			@SettingRow("sv-external-theme", "Use an external theme", "Read colors from a theme file (Noctalia) and follow its changes.") {
				<input type="hidden" name={ configFieldExternalThemeEnabled } value="off"/>
				<input id="sv-external-theme" class="sv-switch" name={ configFieldExternalThemeEnabled } type="checkbox" role="switch" checked?={ theme.Enabled } data-sv-external-theme-toggle/>
			}
			<div class="sv-setting-dependents">
				@SettingRow("sv-external-provider", "Provider", "Theme source. Only noctalia is supported.") {
					<input id="sv-external-provider" class="sv-input" name="external_theme_provider" type="text" value={ theme.Provider } placeholder="noctalia" spellcheck="false"/>
				}
				@SettingRow("sv-external-format", "Format", "colors-json reads Noctalia's colors.json; dumber-json is a custom template.") {
					<select id="sv-external-format" class="sv-input sv-select" name="external_theme_format">
						for _, format := range externalThemeFormats(theme.Format) {
							<option value={ format } selected?={ format == theme.Format }>{ externalThemeFormatLabel(format) }</option>
						}
					</select>
				}
				@SettingRow("sv-external-path", "File", "") {
					<input id="sv-external-path" class="sv-input sv-input-mono sv-input-wide" name="external_theme_path" type="text" value={ theme.Path } placeholder="~/.config/noctalia/colors.json" spellcheck="false"/>
				}
			</div>
		</div>
	}
}

templ ConfigSearch(config dto.SystemviewConfigPayload) {
	@ConfigSection("sv-config-search", "Search", "Where the omnibox sends searches, and shortcuts such as “gh query”.") {
		@SettingsCard("") {
			<div class="sv-setting sv-setting-stacked" data-sv-setting>
				<div class="sv-setting-text">
					<label class="sv-setting-label" for="sv-search-engine">Default search engine</label>
					<p class="sv-setting-help">%s is replaced by what you type.</p>
				</div>
				<div class="sv-setting-control">
					<input id="sv-search-engine" class="sv-input sv-input-mono sv-input-wide" name="default_search_engine" type="text" inputmode="url" value={ config.DefaultSearchEngine } placeholder="https://duckduckgo.com/?q=%s" pattern=".*%s.*" spellcheck="false" required/>
				</div>
			</div>
		}
		@SettingsCard("Search shortcuts") {
			{{ rows := searchShortcutRows(config.SearchShortcuts) }}
			<div class="sv-shortcut-table" role="table" aria-label="Search shortcuts" data-sv-shortcut-table>
				<div class="sv-shortcut-head" role="row">
					<span role="columnheader">Key</span>
					<span role="columnheader">URL</span>
					<span role="columnheader">Description</span>
					<span role="columnheader"><span class="sv-sr-only">Delete</span></span>
				</div>
				for i, row := range rows {
					@SearchShortcutRow(strconv.Itoa(i), row, false)
				}
				@SearchShortcutRow(strconv.Itoa(len(rows)), searchShortcutRow{}, true)
			</div>
			<p class="sv-settings-card-note">Type in the last row to add a shortcut. Deleted rows are removed when you save.</p>
		}
	}
}

templ SearchShortcutRow(index string, row searchShortcutRow, isNew bool) {
	{{ prefix := configShortcutPrefix + index + "." }}
	<div class="sv-shortcut-row" role="row" data-sv-shortcut-row data-sv-shortcut-new?={ isNew }>
		<input type="hidden" name={ prefix + "original" } value={ row.Key }/>
		<span role="cell"><input class="sv-input sv-input-mono" name={ prefix + "key" } type="text" value={ row.Key } placeholder={ shortcutPlaceholder(isNew, "key") } aria-label="Shortcut key" spellcheck="false"/></span>
		<span role="cell"><input class="sv-input sv-input-mono" name={ prefix + "url" } type="text" value={ row.URL } placeholder={ shortcutPlaceholder(isNew, "url") } pattern=".*%s.*" aria-label="Search URL, with %s for the query" spellcheck="false"/></span>
		<span role="cell"><input class="sv-input" name={ prefix + "description" } type="text" value={ row.Description } placeholder={ shortcutPlaceholder(isNew, "description") } aria-label="Description"/></span>
		<span role="cell">
			if !isNew {
				<label class="sv-shortcut-delete" title="Delete when saving">
					<input type="checkbox" name={ prefix + "delete" } value="on" aria-label={ "Delete search shortcut " + row.Key }/>
					@Icon(iconTrash)
				</label>
			}
		</span>
	</div>
}

templ ConfigPerformance(config dto.SystemviewConfigPayload) {
	{{ profile := normalizedOption(config.Performance.Profile, "default") }}
	@ConfigSection("sv-config-performance", "Performance", performanceDescription(config.EngineType)) {
		@SettingsCard("") {
			@SettingGroupRow("sv-profile-label", "Profile", "Default tunes Dumber from your hardware. Custom unlocks each value.") {
				@Segmented("profile", "sv-profile-label", performanceProfileOptions, profile, templ.Attributes{"data-sv-performance-profile": true})
			}
			<div class="sv-setting sv-setting-info">
				<span class="sv-setting-label">Detected hardware</span>
				<span class="sv-hardware">{ hardwareSummary(config) }</span>
			</div>
		}
		<div class="sv-performance-custom">
			@SettingsCard("Custom values") {
				for _, field := range performanceCustomFields(config.Performance.Custom) {
					@SettingRow("sv-perf-"+field.Name, field.Label, field.Help) {
						<input id={ "sv-perf-" + field.Name } class="sv-input sv-input-number" name={ field.Name } type="number" min={ strconv.Itoa(field.Min) } max={ strconv.Itoa(field.Max) } value={ strconv.Itoa(field.Value) } required disabled?={ profile != customPerformanceProfile } data-sv-performance-custom/>
					}
				}
			}
		</div>
	}
}

templ ConfigKeybindings(keybindings port.KeybindingsConfig) {
	{{ groups := configKeybindingGroups(keybindings) }}
	@ConfigSection("sv-config-keybindings", "Keybindings", configKeybindingSummary(keybindings)) {
		if groups == nil {
			@EmptyState("Keybindings unavailable")
		} else if len(groups) == 0 {
			@EmptyState("No keybindings configured")
		} else {
			<div class="sv-kb-toolbar">
				<div class="sv-search-field sv-kb-filter">
					@Icon(iconSearch)
					<input type="search" placeholder="Filter by action or key…" aria-label="Filter keybindings" spellcheck="false" data-sv-keybinding-filter/>
				</div>
				<button class="sv-text-button sv-text-button-danger" type="button" data-sv-action="config.keybinding.resetAll" data-sv-confirm="Reset all keybindings to defaults? Unsaved changes on this page are lost.">
					@ButtonIconLabel(iconRotateCCW, "Reset all")
				</button>
			</div>
			<p class="sv-kb-empty" data-sv-keybinding-empty hidden>No keybinding matches this filter.</p>
			for _, group := range groups {
				@ConfigKeybindingGroup(group)
			}
		}
	}
}

templ ConfigKeybindingGroup(group renderedKeybindingGroup) {
	<div class="sv-settings-card sv-kb-group" data-sv-kb-group>
		<div class="sv-kb-group-header">
			<h3 class="sv-settings-card-title">{ keybindingGroupTitle(group) }</h3>
			if group.Activation != "" {
				<span class="sv-kb-activation">
					Activate with
					@KeyList([]string{ group.Activation })
				</span>
			}
		</div>
		if len(group.Bindings) == 0 {
			@EmptyState("No bindings in this group")
		} else {
			for _, binding := range group.Bindings {
				@ConfigKeybinding(group, binding)
			}
		}
	</div>
}

templ ConfigKeybinding(group renderedKeybindingGroup, binding renderedKeybinding) {
	{{ inputID := keybindingInputID(group.Mode, binding.Action) }}
	<div class="sv-kb-row" data-sv-kb-row data-sv-kb-mode={ group.Mode }>
		<div class="sv-kb-text">
			<label class="sv-kb-label" for={ inputID }>{ keybindingDescription(binding) }</label>
			<span class="sv-kb-action">{ keybindingAction(binding) }</span>
		</div>
		<div class="sv-kb-keys" data-sv-kb-keys>
			<input id={ inputID } class="sv-input sv-input-mono sv-kb-input" name={ keybindingFieldName(group.Mode, binding.Action) } type="text" value={ formatKeyList(binding.Keys) } placeholder="Unassigned" spellcheck="false" data-sv-kb-input data-default-keys={ formatKeyList(binding.DefaultKeys) }/>
			if keybindingGroupRecordable(group) {
				<button class="sv-icon-button sv-kb-record" type="button" aria-pressed="false" aria-label={ "Record keys for " + keybindingDescription(binding) } title="Record keys" data-sv-kb-record>
					@Icon(iconKeyboard)
				</button>
			}
			<button class="sv-icon-button sv-kb-reset" type="button" data-sv-action={ uiActionConfigResetKeys } data-sv-kb-reset hidden?={ !keybindingIsCustom(binding) } aria-label={ "Reset " + keybindingDescription(binding) + " to its default keys" } title={ "Default: " + keybindingDefaultLabel(binding) }>
				@Icon(iconRotateCCW)
			</button>
		</div>
		<p class="sv-kb-conflict" data-sv-kb-conflict hidden></p>
	</div>
}

templ ConfigAdvanced(config dto.SystemviewConfigPayload) {
	@ConfigSection("sv-config-advanced", "Advanced", "Every stored value, read-only. Edit the config file for settings not shown above.") {
		<details class="sv-settings-card sv-config-details">
			<summary>Raw configuration values</summary>
			@KV(flattenValues(config))
		</details>
	}
}

templ ConfigSaveBar() {
	<div class="sv-savebar" data-sv-savebar>
		<div class="sv-savebar-status" data-sv-region={ configRegionStatus } aria-live="polite">
			@ConfigStatus(configStatus{})
		</div>
		<div class="sv-savebar-actions">
			<button class="sv-button sv-button-neutral" type="reset" form={ configFormID } data-sv-discard>Discard</button>
			<button class="sv-button" type="submit" form={ configFormID }>
				<span>Save changes</span>
				<kbd class="sv-button-kbd">Ctrl S</kbd>
			</button>
		</div>
	</div>
}

templ ConfigStatus(status configStatus) {
	if status.Error != "" {
		<p class="sv-savebar-error" role="alert" data-sv-error-field={ status.Field }>
			@Icon(iconAlert)
			<span>{ status.Error }</span>
		</p>
	} else {
		<p class="sv-savebar-message" data-sv-dirty-label>Changes are saved together</p>
	}
}
